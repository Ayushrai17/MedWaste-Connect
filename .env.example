# ==============================================================================
# MEDWASTE CONNECT — ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the project root: cp .env.example .env
# 2. Update the values below for your environment (development, staging, or production).
# 3. Never commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Core Application Settings
# Generate a strong unique key locally, e.g.:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-to-a-secure-random-50-character-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver,medwaste.example.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost,https://medwaste.example.com

# Production Security & SSL Hardening
# (Set to True in production environments when serving over HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# HTTP Strict Transport Security (HSTS)
# (Recommended for production: 31536000 for 1 year)
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Operational Biomedical Waste Thresholds (Schedule I CPCB 2016 Guidelines)
MIN_WASTE_BAG_WEIGHT_KG=0.05
MAX_WASTE_BAG_WEIGHT_KG=25.00

# Optional Local Demo Account Seeding (only evaluated when DEBUG=True)
# Set explicit non-predictable passwords locally, or omit them to generate random per-run passwords.
# MEDWASTE_DEMO_ADMIN_PASSWORD=set-your-local-admin-demo-password
# MEDWASTE_DEMO_HOSPITAL_PASSWORD=set-your-local-hospital-demo-password
# MEDWASTE_DEMO_COLLECTOR_PASSWORD=set-your-local-collector-demo-password
# MEDWASTE_DEMO_FACILITY_PASSWORD=set-your-local-facility-demo-password
